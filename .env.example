APP_NAME=Pixode
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
# For MySQL: change DB_CONNECTION=mysql and uncomment the fields below.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pixode
# DB_USERNAME=root
# DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true for HTTPS deployment
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=hello@your-domain.com
MAIL_FROM_NAME=Pixode
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PIXODE_NODE_BINARY=node

# SQL Express / Windows Authentication. Install PHP pdo_sqlsrv first.
DB_CONNECTION=sqlsrv
DB_HOST='.\SQLEXPRESS'
DB_PORT=
DB_DATABASE=PixodeLaravel
DB_USERNAME=null
DB_PASSWORD=null
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true